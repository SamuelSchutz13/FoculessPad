PORT=3000
# Comma-separated front-end origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
# SQLite file
DATABASE_PATH=data/foculesspad.sqlite
# Required when NODE_ENV=production (min 32 chars recommended); in dev a random one is generated
# APP_SECRET=
# Unlock session lifetime
SESSION_TTL_MINUTES=60
# Largest note (update or snapshot), in KB
MAX_PAD_SIZE_KB=512
# Requests per minute, per IP
RATE_LIMIT_PER_MINUTE=60
# Unlock attempts per minute, per IP
UNLOCK_RATE_LIMIT_PER_MINUTE=5
